datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  role      String    @default("staff")
  invoices  Invoice[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Branch {
  id        Int            @id @default(autoincrement())
  name      String
  type      BranchType     @default(STORE)
  stocks    ProductStock[]
  lots      StockLot[]
  safes     Safe[]
  invoices  Invoice[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

enum BranchType {
  STORE
  WAREHOUSE
}

model Category {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  brandModels BrandModel[]
  products    Product[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum BrandModelKind {
  MARKA
  MODEL
}

model BrandModel {
  id         Int            @id @default(autoincrement())
  name       String
  kind       BrandModelKind @default(MODEL)
  categoryId Int?
  category   Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// MODEL kayıtları bağlı oldukları MARKA kaydını gösterir; MARKA
  /// kayıtlarında boştur. Marka silinirse model sahipsiz kalır (SetNull) —
  /// modele bağlı ürün kartları bozulmasın diye model silinmez.
  parentId   Int?
  parent     BrandModel?    @relation("BrandModelHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   BrandModel[]   @relation("BrandModelHierarchy")
  products   Product[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([name, categoryId, kind])
}

model Product {
  id             Int            @id @default(autoincrement())
  sku            String         @unique
  barcode        String?        @unique
  name           String
  brand          String?
  model          String?
  color          String?
  appearance     String?
  quality        String?
  rbmPrice       Float          @default(0.0)
  description    String?        @db.Text
  /// Muadil model adlari — Excel'deki "Uyumlu" sutunu. Virgulle ayrilmis
  /// serbest metin; eslesme model adi / urun adi uzerinden yapilir.
  /// Iliski simetriktir: A muadili B yazmak B muadili A demektir.
  compatibleWith String?        @db.Text
  /// VARSAYILAN maliyet — elle girilir.
  /// Stokta katman kalmadiginda (stoksuz satis) veya hic alis kaydi
  /// yokken bu deger kullanilir. Alis islemi ARTIK BUNU EZMEZ;
  /// her alis kendi StockLot katmanini acar.
  costPrice      Float          @default(0.0)
  priceTl        Float          @default(0.0)
  /// Satış 1 (Toptan) — satışta varsayılan fiyat
  priceUsd       Float          @default(0.0)
  /// Satış 2 (Perakende) — başlangıçta Satış 1 ile aynı
  priceUsd2      Float          @default(0.0)
  categoryId     Int?
  brandModelId   Int?
  category       Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandModel     BrandModel?    @relation(fields: [brandModelId], references: [id], onDelete: SetNull)
  stocks         ProductStock[]
  lots           StockLot[]
  invoiceItems   InvoiceItem[]

  /// ÇÖP KUTUSU — dolu ise ürün hiçbir listede görünmez.
  ///
  /// Kayıt SİLİNMEZ çünkü geçmiş faturalar ürüne işaret eder; silinirse
  /// o faturalar ürün adını kaybeder ve okunamaz hale gelir. Gizlenen
  /// ürün faturalarda ve raporlarda aynen görünmeye devam eder.
  ///
  /// Hiç faturada geçmemiş bir ürün çöp kutusundan KALICI silinebilir
  /// (yanlış açılmış kart, mükerrer kayıt); faturası olan silinemez.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
}

model ProductStock {
  id        Int     @id @default(autoincrement())
  productId Int
  branchId  Int
  quantity  Float   @default(0.0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
}

/// Stok katmani (FIFO).
///
/// Her alis, kendi birim maliyetiyle bir katman acar. Satis en ESKI
/// katmandan tuketir; boylece "hangi mali kaca aldim" bilgisi kaybolmaz.
///
/// Neden gerekti: onceden urunun tek bir costPrice alani vardi ve her
/// alis onu son alis fiyatina esitliyordu. Stokta 1 adet 1,00 dolarlik
/// mal dururken 1,20'ye alim yapilinca eldeki eski malin maliyeti de
/// 1,20 oluyordu — 3 adetlik satis 3,60 gorunuyordu, gercegi 3,40 iken.
model StockLot {
  id        Int @id @default(autoincrement())
  productId Int
  branchId  Int

  /// Katmanda KALAN miktar. Satis tukettikce azalir; 0 olunca katman
  /// kapanir ama kayit silinmez (gecmis iz).
  quantity Float

  /// Bu katmanin birim maliyeti (USD)
  unitCost Float

  /// Katmani acan alis kalemi. Fatura silinir/duzenlenirse katman
  /// bunun uzerinden bulunur.
  sourceInvoiceItemId Int?

  /// Acilis katmani mi — surume gecerken mevcut stoktan uretilenler.
  /// Bunlarin gercek bir alis kaydi yoktur.
  isOpening Boolean @default(false)

  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  /// FIFO sirasi: en eski katman once tuketilir
  @@index([productId, branchId, createdAt])
  @@index([sourceInvoiceItemId])
}

model Customer {
  id            Int           @id @default(autoincrement())
  code          String        @unique
  name          String
  contactPerson String?
  address       String?       @db.Text
  district      String?
  city          String?
  email         String?
  phone         String?
  taxOffice     String?
  taxNumber     String?
  creditLimit   Float         @default(0.0)
  balance       Float         @default(0.0)
  invoices      Invoice[]
  transactions  Transaction[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Safe {
  id           Int           @id @default(autoincrement())
  branchId     Int
  name         String
  currency     String        @default("TRY")
  balance      Float         @default(0.0)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  invoices     Invoice[]
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Invoice {
  id                Int           @id @default(autoincrement())
  invoiceNo         String        @unique
  type              String        @default("SATIS")
  customerId        Int
  safeId            Int
  branchId          Int
  userId            Int?
  paymentMethod     String        @default("Nakit")
  paymentType       String?
  exchangeRate      Float         @default(1.0)
  deliveryType      String        @default("Mağazadan Teslim")
  dueDate           DateTime?
  isPreOrder        Boolean       @default(false)
  processedBy       String?
  orderNotes        String?       @db.Text
  shippingCompany   String?
  trackingNumber    String?
  totalAmountTl     Float         @default(0.0)
  totalAmountUsd    Float         @default(0.0)

  /// Fis uzerinde TL karsiligi yazmak icin, fatura kesilirken kaydedilen
  /// TCMB USD satis kuru.
  ///
  /// MUHASEBEYE GIRMEZ. Tutarlar USD'dir; bakiye, kar ve raporlar bu alandan
  /// hesaplanmaz. Yalnizca fisin uzerine "≈ 12.450,00 TL" yazmak icindir.
  /// `exchangeRate` ile KARISTIRILMAMALI: o alan totalAmountTl/totalAmountUsd
  /// donusumunu tanimlar ve her zaman 1'dir (tutarlar zaten USD tutulur).
  /// Bos ise (eski kayitlar) fise TL satiri basilmaz.
  tryRate           Float?
  originalInvoiceId Int?
  originalInvoice   Invoice?      @relation("InvoiceReturns", fields: [originalInvoiceId], references: [id], onDelete: SetNull)
  returnInvoices    Invoice[]     @relation("InvoiceReturns")
  customer          Customer      @relation(fields: [customerId], references: [id])
  safe              Safe          @relation(fields: [safeId], references: [id])
  branch            Branch        @relation(fields: [branchId], references: [id])
  user              User?         @relation(fields: [userId], references: [id])
  items             InvoiceItem[]
  deletedAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

enum TransactionType {
  GIRIS
  CIKIS
}

model Transaction {
  id          Int             @id @default(autoincrement())
  safeId      Int
  customerId  Int?
  type        TransactionType
  amount      Float
  method      String?
  /// Cari tahsilat/tediye fiş no — faturalardan bağımsız seri (ÖDM-YYYY-0001).
  /// Fatura kaynaklı kasa hareketlerinde null kalır.
  receiptNo   String?         @unique
  description String

  /// Tahsilat/tediye fisine TL karsiligi yazmak icin kaydedilen TCMB USD
  /// satis kuru. Invoice.tryRate ile ayni kural: gosterim icindir, `amount`
  /// USD'dir ve bakiye bu alandan hesaplanmaz.
  tryRate     Float?
  safe        Safe            @relation(fields: [safeId], references: [id])
  customer    Customer?       @relation(fields: [customerId], references: [id])
  createdAt   DateTime        @default(now())
}

model InvoiceItem {
  id        Int   @id @default(autoincrement())
  invoiceId Int
  productId Int
  quantity  Float
  unitPrice Float

  /// SATIS aninda DONDURULAN birim maliyet (USD).
  ///
  /// Neden: kar raporu eskiden urunun GUNCEL costPrice'ini kullaniyordu,
  /// bu yuzden kapanmis aylarin kari her yeni alista geriye donuk
  /// degisiyordu. Artik satirin maliyeti satis aninda yazilir ve bir
  /// daha oynamaz.
  ///
  /// null = bu alan eklenmeden once olusmus eski kayit; raporlar o
  /// durumda urunun costPrice'ina duser.
  unitCost            Float?
  discountPercent     Float         @default(0)
  totalPrice          Float
  sourceInvoiceItemId Int?
  isChinaReturn       Boolean       @default(false)
  sourceInvoiceItem   InvoiceItem?  @relation("ItemReturns", fields: [sourceInvoiceItemId], references: [id], onDelete: SetNull)
  returnedItems       InvoiceItem[] @relation("ItemReturns")
  invoice             Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product             Product       @relation(fields: [productId], references: [id])
}
